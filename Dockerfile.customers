FROM rust:1.84 AS builder

WORKDIR /app

# Install nightly for edition 2024
RUN rustup default nightly

# Copy manifests
COPY Cargo.toml ./

# Copy source code
COPY src ./src

# Build the customers subgraph binary
RUN cargo build --release --bin customers-subgraph

# Runtime stage
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy the binary from builder
COPY --from=builder /app/target/release/customers-subgraph /app/customers-subgraph

EXPOSE 3003

CMD ["/app/customers-subgraph"]
