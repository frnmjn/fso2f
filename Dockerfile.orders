FROM rust:1.84 AS builder

WORKDIR /app

# Install nightly for edition 2024
RUN rustup default nightly

# Copy manifests
COPY Cargo.toml ./

# Copy source code
COPY src ./src

# Build the orders subgraph binary
RUN cargo build --release --bin orders-subgraph

# Runtime stage
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy the binary from builder
COPY --from=builder /app/target/release/orders-subgraph /app/orders-subgraph

EXPOSE 3002

CMD ["/app/orders-subgraph"]
